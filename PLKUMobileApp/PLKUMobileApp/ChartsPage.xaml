<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PLKUMobileApp.ChartsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#B85D85">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <!-- GLOBAL DARK MODE TOGGLE -->
            <Button x:Name="btnDarkMode"
                    Text="🌙 Dark"
                    Clicked="OnToggleDarkModeClicked"
                    HorizontalOptions="End"
                    BackgroundColor="#69143E"
                    TextColor="#FCEEF2"
                    BorderColor="#FCEEF2"
                    BorderWidth="1"
                    FontSize="12"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="34"
                    Padding="14,0" />

            <!-- HEADER BANNER -->
            <Border x:Name="cardHeader"
                    BackgroundColor="#FCEEF2"
                    Stroke="#7A1C4B"
                    StrokeThickness="1.5"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="lblChartsTitle"
                           Text="STUDENT CHARTS &amp; REPORTS"
                           TextColor="#69143E"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="lblChartsSubtitle"
                           Text="Enrollment Rate • Survival Rate • Status Distribution"
                           TextColor="#7A2850"
                           FontSize="12"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 1. ENROLLMENT COUNT PER YEAR (BY PROGRAM) -->
            <Border x:Name="cardEnrollmentChart"
                    BackgroundColor="#FCEEF2"
                    Stroke="#7A1C4B"
                    StrokeThickness="1.5"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lblEnrollmentTitle"
                           Text="Enrollment Count per Year (by Program)"
                           TextColor="#69143E"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <GraphicsView x:Name="gvEnrollmentChart"
                                  HeightRequest="220" />

                    <VerticalStackLayout x:Name="enrollmentLegendContainer" Spacing="4" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. SURVIVAL RATE PER COURSE (GRADUATED %) -->
            <Border x:Name="cardSurvivalChart"
                    BackgroundColor="#FCEEF2"
                    Stroke="#7A1C4B"
                    StrokeThickness="1.5"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lblSurvivalTitle"
                           Text="Survival Rate per Course (Graduated %)"
                           TextColor="#69143E"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <GraphicsView x:Name="gvSurvivalChart"
                                  HeightRequest="220" />

                    <VerticalStackLayout x:Name="survivalSummaryContainer" Spacing="4" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. STUDENT STATUS DISTRIBUTION (TRANSFER RATE) -->
            <Border x:Name="cardStatusChart"
                    BackgroundColor="#FCEEF2"
                    Stroke="#7A1C4B"
                    StrokeThickness="1.5"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lblStatusTitle"
                           Text="Student Status Distribution (Transfer Rate)"
                           TextColor="#69143E"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <GraphicsView x:Name="gvStatusPieChart"
                                  HeightRequest="210" />

                    <VerticalStackLayout x:Name="statusLegendContainer" Spacing="4" />
                </VerticalStackLayout>
            </Border>

            <!-- EXPORT BUTTONS -->
            <Border x:Name="cardActions"
                    BackgroundColor="#FCEEF2"
                    Stroke="#7A1C4B"
                    StrokeThickness="1.5"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Button x:Name="btnExportEnrollment"
                            Text="Export Enrollment Rate Chart"
                            Clicked="OnExportEnrollmentClicked"
                            BackgroundColor="#F8D7E4"
                            BorderColor="#8E295A"
                            BorderWidth="1.5"
                            TextColor="#69143E"
                            FontSize="12.5"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="42" />

                    <Button x:Name="btnExportSurvival"
                            Text="Export Survival Rate Chart"
                            Clicked="OnExportSurvivalClicked"
                            BackgroundColor="#F8D7E4"
                            BorderColor="#8E295A"
                            BorderWidth="1.5"
                            TextColor="#69143E"
                            FontSize="12.5"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="42" />

                    <Button x:Name="btnExportTransfer"
                            Text="Export Transfer Rate Chart"
                            Clicked="OnExportTransferClicked"
                            BackgroundColor="#F8D7E4"
                            BorderColor="#8E295A"
                            BorderWidth="1.5"
                            TextColor="#69143E"
                            FontSize="12.5"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="42" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="btnRefreshCharts"
                                Grid.Column="0"
                                Text="Refresh Charts"
                                Clicked="OnRefreshChartsClicked"
                                BackgroundColor="#F10291"
                                TextColor="White"
                                FontSize="12.5"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="42" />

                        <Button x:Name="btnBackToDashboard"
                                Grid.Column="1"
                                Text="Back to Dashboard"
                                Clicked="OnBackToDashboardClicked"
                                BackgroundColor="#69143E"
                                TextColor="White"
                                FontSize="12.5"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="42" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- FOOTER -->
            <Label x:Name="lblFooter"
                   Text="PLK University · Student Charts and Reports"
                   TextColor="#FCEEF2"
                   FontSize="11.5"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,4,0,10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>